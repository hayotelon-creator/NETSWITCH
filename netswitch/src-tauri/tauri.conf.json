{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetSwitch",
  "version": "0.1.0",
  "identifier": "fr.elonhayot.netswitch",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NetSwitch — Elon Hayot",
        "width": 960,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Elon Hayot",
    "copyright": "© 2026 Elon Hayot. Tous droits réservés.",
    "category": "Utility",
    "shortDescription": "Gestionnaire de profils réseau",
    "longDescription": "NetSwitch, par Elon Hayot : profils IP/DNS en un clic, multi-IP, détection automatique et scan du réseau."
  }
}